# Copy to .env.local for local dev
# Bun auto-loads .env.local

# Required
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_ALLOWED_USERS=user_id_1,user_id_2
COMPOSIO_API_KEY=your_composio_api_key
AI_API_KEY=your_api_key

# Optional
# AI_BASE_URL=https://api.openai.com/v1
# MODEL=gpt-4o-mini
# LOG_LEVEL=INFO
# AGENT_MAX_STEPS=25

# Max chars of a tool result kept in the conversation sent to the model.
# Large tool results (e.g. Gmail fetch of many messages) can blow past the
# model's context window and cause a negative max_tokens error — this caps it.
MAX_TOOL_RESULT_CHARS=16000

# Comma-separated Telegram user IDs that may use tools marked `adminOnly`.
# Leave empty and NOBODY is an admin, so every adminOnly tool is hidden from
# everyone. Deny by default: a missing value hides a tool rather than exposing it.
# ADMIN_USER_IDS=user_id_1

# ── Model fallback ────────────────────────────────────────────────────────────
# If the primary model starts failing (401/403/402/429/5xx) the bot switches to
# the fallback automatically. This is the cheapest insurance against a provider
# outage or a revoked key.
#
# The switch is STICKY and survives restarts: it writes data/.fallback-active and
# stays on the fallback until you delete that file (or call
# router.resetFallbackState()). Auto-reverting would flap between providers during
# a partial outage, and a silent one-time flip back to a broken primary would be
# worse than staying put. The file is the visible, reversible state.
# FALLBACK_MODEL=gpt-4o
# FALLBACK_BASE_URL=https://api.openai.com/v1
# FALLBACK_API_KEY=other_api_key

# How many times to retry the PRIMARY model before switching to the fallback.
# PRIMARY_RETRY_COUNT=2

# Some providers (deepseek, glm) require an explicit output cap. Set for those.
# MAX_OUTPUT_TOKENS=16384

# Per-provider extra HTTP headers, as a JSON object keyed by base-URL substring.
# Use when a provider rejects requests for a missing User-Agent or similar.
# PROVIDER_HEADERS={"openrouter.ai":{"HTTP-Referer":"https://example.com"}}
# PRIMARY_UA=my-bot/1.0
# FALLBACK_UA=my-bot/1.0
